{
  "name": "japanese-learner",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run content:build && next build --webpack",
    "test": "node --test tests/*.cjs",
    "dev": "npm run content:build && next dev --webpack -H 127.0.0.1 -p 8765",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.cjs",
    "test:integration": "node --env-file-if-exists=.env.local scripts/integration.cjs",
    "content:build": "node scripts/prepare-content.cjs",
    "start": "next start -H 127.0.0.1 -p 8765",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run content:build",
    "test:browser": "node tests/browser/desktop.cjs && node tests/browser/mobile.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,cts,cjs,css}\" scripts/prepare-content.cjs tests/browser/*.cjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "html-react-parser": "^6.1.8",
    "jose": "6.2.12",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "30.1.1",
    "marked": "^18.0.14",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
